# 大肥鱼 · Windows 本机部署配置
# 首次运行 start.ps1 会自动复制成 .env（.env 已被 git 忽略）。
# 改完不用重建镜像：start.ps1 -NoBuild 生效。

TZ=Asia/Shanghai

# 都只绑 127.0.0.1。被占用时改成 6186 / 6100 / 3212 之类。
ASTRBOT_PORT=6185
NAPCAT_PORT=6099
SEALDICE_PORT=3211
# OneBot 反向 WS：宿主机上的协议端（如 OpenQQ）连 ws://127.0.0.1:6199/ws
ONEBOT_WS_PORT=6199

# QQ 小号。首次仍要扫码；扫码成功过一次后，重启会尝试快速登录。
QQ_ACCOUNT=

# NapCat WebUI token（可选，留空则随机生成，见 napcat/config/webui.json）
WEBUI_TOKEN=

# QQ 掉线 / 假在线监控（watchdog.py，start.ps1 自动在后台启动；-NoWatchdog 关掉）
# 每隔几分钟检查一次
WATCHDOG_INTERVAL_MIN=10
# 白天连续多少小时一条消息都没收到，就提醒「疑似假在线」
WATCHDOG_SILENCE_HOURS=3
# 只在这个时段里看「没收到消息」（夜里本来就安静），格式 起-止 点，北京时间
WATCHDOG_ACTIVE_HOURS=9-24
# 监控哪个协议端：auto（OpenQQ 在跑就查它，否则查 NapCat 容器）/ openqq / napcat
WATCHDOG_PROTOCOL=auto
# 用 OpenQQ 时填它的目录（读 .runtime\status.json 判断是否被踢下线），例如 D:\RAG-ai-code\OpenQQ
OPENQQ_DIR=

# 记忆插件的记忆文件放在宿主机哪个目录（Markdown + git，可直接打开修改）。
# 留空 = 本目录下的 memory\；也可以写绝对路径，例如 D:\伽拉忒亚的记忆
MEMORY_DIR=
